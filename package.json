{
  "name": "e-wastefi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Decentralized electronic-waste recycling and reward platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "compile": "cd blockchain && npx hardhat compile",
    "test": "cd blockchain && npx hardhat test",
    "deploy:local": "cd blockchain && npx hardhat run scripts/deploy-all.js",
    "deploy:ganache": "cd blockchain && npx hardhat run scripts/deploy-all.js --network ganache",
    "export-abis": "cd blockchain && node scripts/export-abis.js"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
